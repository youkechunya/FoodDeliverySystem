<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.fooddeliverysystem.mapper.UserRoleMapper">

    <resultMap id="roleMap" type="com.javaee.fooddeliverysystem.entity.Role">
        <id column="id" property="id"/>
        <result column="role" property="roleName"/>
    </resultMap>

    <select id="selectRolesByUserId" resultMap="roleMap">
        select r.id, r.role
        from role r
                 inner join user_role ur on r.id = ur.roleId
        where ur.userId = #{userId}
    </select>

    <delete id="deleteByUserId">
        delete from user_role
        where userId = #{userId}
    </delete>

    <insert id="insertBatch">
        insert into user_role(userId, roleId)
        values
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <insert id="insert">
        insert into user_role(userId, roleId)
        values (#{userId}, #{roleId})
    </insert>

    <delete id="delete">
        delete from user_role
        where userId = #{userId}
          and roleId = #{roleId}
    </delete>

</mapper>