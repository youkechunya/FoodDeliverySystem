<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.fooddeliverysystem.mapper.RoleMapper">
    <resultMap id="roleMap" type="com.javaee.fooddeliverysystem.entity.Role">
        <id column="id" property="id"/>
        <result column="role" property="role"/>
    </resultMap>
    <select id="selectAll" resultMap="roleMap">
        select id,role from role
    </select>
    <select id="selectById" resultMap="roleMap">
        select id,role from role where id=#{id}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into role(role) values(#{role})
    </insert>
    <update id="update">
        update role set role=#{role} where id=#{id}
    </update>
    <delete id="deleteById">
        delete from role where id=#{id}
    </delete>
</mapper>