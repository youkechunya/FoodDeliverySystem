<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.fooddeliverysystem.mapper.MenuMapper">
    <resultMap id="menuMap" type="com.javaee.fooddeliverysystem.entity.Menu">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="url" property="url"/>
        <result column="roleId" property="roleId"/>
    </resultMap>
    <select id="selectByRoleId" resultMap="menuMap">
        select id,name,url,roleId from menu where roleId=#{roleId}
    </select>
</mapper>